{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}",
      "!**/node_modules/**",
      "!**/vendor/**",
      "!**/public/**",
      "!**/storage/**",
      "!**/bootstrap/cache/**",
      "!**/uc-plugin/**",
      "!**/shopify_theme/**",
      "!postcss.config.js",
      "!vite.config.ts",
      "!tailwind.config.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  }
}
