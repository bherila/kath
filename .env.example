APP_NAME="Katherine Herila"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This site has no domain tables yet (see database/migrations — empty).
# DB_CONNECTION points at the shared production MySQL host directly; there
# is no local database. Placeholders only — ask for real credentials.
DB_CONNECTION=mysql
DB_HOST=replace-with-prod-mysql-host
DB_PORT=3306
DB_DATABASE=replace-with-database-name
DB_USERNAME=replace-with-database-username
DB_PASSWORD=replace-with-database-password

# No login/auth and no queued jobs yet, so sessions/cache/queue use
# file-backed drivers instead of database tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible) for photo/video asset storage — bucket is
# being provisioned separately. Placeholder values only.
KATH_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
KATH_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
KATH_R2_REGION=auto
KATH_R2_BUCKET=replace-with-r2-bucket-name
KATH_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
# Optional public/custom base URL. Leave blank for a private R2 bucket.
KATH_R2_URL=
KATH_R2_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
