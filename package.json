{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "jest --passWithNoTests",
        "type-check": "tsc --noEmit",
        "lint": "oxlint --type-aware && pnpm run lint:unused-imports",
        "lint:fix": "oxlint --type-aware --fix && pnpm run lint:unused-imports",
        "postinstall": "node scripts/spotlight-noindex.mjs",
        "lint:unused-imports": "node scripts/lint-unused-imports.mjs",
        "lint:unused-imports:fix": "node scripts/lint-unused-imports.mjs --fix",
        "lint:test": "node --test tools/oxlint/*.test.mjs",
        "toolchain:check": "node scripts/check-lint-toolchain.mjs",
        "test:dependency-security": "node --test scripts/dependencies/*.contract.cjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@jest/types": "^30.5.1",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "autoprefixer": "^10.6.2",
        "axios": "^1.21.1",
        "concurrently": "^10.0.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "laravel-vite-plugin": "^3.2.1",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "postcss": "^8.5.33",
        "spotlight-noindex": "1.1.1",
        "tailwindcss": "^4.3.5",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@noble/hashes": "^2.4.0",
        "blockhash-core": "^0.1.0",
        "class-variance-authority": "^0.7.1",
        "classnames": "^2.5.1",
        "clsx": "^2.1.1",
        "exifr": "^7.1.3",
        "hls.js": "^1.7.4",
        "lucide-react": "^1.73.0",
        "react": "^19.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.92.0",
        "tailwind-merge": "^3.7.0"
    }
}
